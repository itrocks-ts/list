{
	"author": {
		"name": "Baptiste Pillot",
		"email": "baptiste@pillot.fr"
	},
	"dependencies": {
		"@itrocks/action": "latest",
		"@itrocks/action-pack": "latest",
		"@itrocks/action-request": "latest",
		"@itrocks/build": "latest",
		"@itrocks/class-type": "latest",
		"@itrocks/class-view": "latest",
		"@itrocks/composition": "latest",
		"@itrocks/core-transformers": "latest",
		"@itrocks/decorator": "latest",
		"@itrocks/list-properties": "latest",
		"@itrocks/property-select": "latest",
		"@itrocks/property-view": "latest",
		"@itrocks/reflect": "latest",
		"@itrocks/reflect-path": "latest",
		"@itrocks/request-response": "latest",
		"@itrocks/route": "latest",
		"@itrocks/sort": "latest",
		"@itrocks/storage": "latest",
		"@itrocks/table": "latest",
		"@itrocks/translate": "latest",
		"@itrocks/transformer": "latest",
		"@itrocks/xtarget": "latest"
	},
	"description": "Generic action-based object list navigation in HTML and JSON",
	"devDependencies": {
		"@itrocks/class-file": "latest",
		"@itrocks/fastify-file-session-store": "latest",
		"@types/node": "^24.10",
		"sass": "^1.95",
		"typescript": "^7.0"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": "./cjs/list.js",
		"./multiple-output": "./cjs/multiple-output.js",
		"./projection": "./cjs/projection.js",
		"./property-select.js": "./property-select.js",
		"./selector-state": "./cjs/selector-state.js",
		"./selector-state.js": "./selector-state.js"
	},
	"homepage": "https://it.rocks",
	"files": [
		"config.yaml",
		"LICENSE",
		"README.md",
		"cjs",
		"/*.svg",
		"*.css",
		"*.d.ts",
		"*.js"
	],
	"keywords": [
		"action",
		"API",
		"backend",
		"browse",
		"component",
		"display",
		"filter",
		"html",
		"interactive",
		"json",
		"list",
		"it.rocks",
		"output",
		"responsive",
		"search",
		"select",
		"selection",
		"standard",
		"view",
		"UI",
		"UX"
	],
	"license": "ISC",
	"name": "@itrocks/list",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itrocks-ts/list.git"
	},
	"scripts": {
		"build": "npm run build:cjs && npm run build:css && npm run build:front",
		"build:cjs": "tsc && node -e \"const fs=require('node:fs'),path=require('node:path');for(const file of fs.readdirSync('src'))if(file.endsWith('.html'))fs.copyFileSync(path.join('src',file),path.join('cjs',file))\"",
		"build:css": "sass --no-source-map src/list.scss:list.css && node -e \"const fs=require('node:fs'),path=require('node:path');for(const file of fs.readdirSync('src'))if(file.endsWith('.svg'))fs.copyFileSync(path.join('src',file),file)\"",
		"build:front": "tsc -p src/front/tsconfig.json",
		"test": "npm run build:cjs && node --test \"test/**/*.test.mjs\""
	},
	"version": "0.14.2"
}
